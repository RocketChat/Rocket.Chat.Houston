{
  "name": "@klovekesh37/houston",
  "version": "2.1.7",
  "description": "Reproduce a customer's Rocket.Chat issue on their exact version, in minutes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klovekesh37/houston.git"
  },
  "homepage": "https://github.com/klovekesh37/houston#readme",
  "bugs": {
    "url": "https://github.com/klovekesh37/houston/issues"
  },
  "keywords": [
    "rocket.chat",
    "reproduction",
    "support",
    "docker",
    "kubernetes",
    "cli"
  ],
  "bin": "bin/houston",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.10.0"
  },
  "files": [
    "dist/",
    "data/",
    "bin/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"{src,test,tools}/**/*.{ts,js}\" \"*.mjs\" \"jest*.config.js\" .dependency-cruiser.js",
    "format:write": "prettier --write \"{src,test,tools}/**/*.{ts,js}\" \"*.mjs\" \"jest*.config.js\" .dependency-cruiser.js",
    "test": "jest",
    "test:browser": "jest --config jest.browser.config.js --runInBand",
    "verify:gui-hash": "node tools/gui-hash.js",
    "test:process-contracts": "jest test/seams/exec.test.ts test/seams/docker-cli.test.ts --runInBand",
    "test:timing": "node tools/timing.js",
    "lint:truthiness": "node tools/lint-truthiness.js",
    "depcruise": "node tools/depcruise.js",
    "depcruise:selftest": "node tools/depcruise-selftest.js",
    "test:zero-skips:selftest": "node tools/zero-skips-selftest.js",
    "skill:generate": "node tools/skill-generate.js",
    "skill:check": "node tools/skill-generate.js --check",
    "skill:eval": "node tools/skill-eval.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.10",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "~24.13.4",
    "dependency-cruiser": "~18.2.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "ts-morph": "~27.0.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/sse": "^0.6.0",
    "@fastify/websocket": "^11.3.0",
    "commander": "~14.0.2",
    "fastify": "5.12.5",
    "yaml": "^2.9.1"
  }
}
